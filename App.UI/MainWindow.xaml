<Window x:Class="App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VAG EEPROM Editor - VDO/Continental IMMO4" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: заголовок и кнопка загрузки -->
        <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VAG EEPROM Editor" FontSize="24" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="Редактор дампов EEPROM для приборных панелей VDO/Continental IMMO4" 
                               FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                </StackPanel>
                
                <Button Grid.Column="1" Content="📂 Load Dump" Style="{StaticResource PrimaryButton}" 
                        Click="LoadDump_Click" Padding="20,10" FontSize="14"/>
            </Grid>
        </Border>

        <!-- Основная рабочая область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: информация о приборке -->
            <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📊 Информация о приборной панели" Style="{StaticResource SectionHeader}"/>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="10" Background="#FAFAFA">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Part Number:" Style="{StaticResource DataLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtPartNumber" Style="{StaticResource InfoTextBox}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="HW Version:" Style="{StaticResource DataLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtHwVersion" Style="{StaticResource InfoTextBox}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="SW Version:" Style="{StaticResource DataLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtSwVersion" Style="{StaticResource InfoTextBox}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="VIN:" Style="{StaticResource DataLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtVin" Style="{StaticResource InfoTextBox}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Пробег:" Style="{StaticResource DataLabel}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtMileage" Style="{StaticResource InfoTextBox}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="PIN (IMMO):" Style="{StaticResource DataLabel}"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtPin" Style="{StaticResource InfoTextBox}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="CS:" Style="{StaticResource DataLabel}"/>
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtCs" Style="{StaticResource InfoTextBox}"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="MAC:" Style="{StaticResource DataLabel}"/>
                                <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtMac" Style="{StaticResource InfoTextBox}"/>
                            </Grid>
                        </Border>

                        <!-- Статус иммобилайзера -->
                        <TextBlock Text="🔐 Иммобилайзер" Style="{StaticResource SectionHeader}"/>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="10" Background="#FAFAFA">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtImmoStatus" Text="Статус: Не загружено" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="1" Width="15" Height="15" x:Name="EllImmoIndicator" 
                                             Fill="#CCCCCC" Margin="5,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="TxtKeyCount" Text="Ключей прописано: 0" Margin="0,5,0,0" Foreground="#666"/>
                            </StackPanel>
                        </Border>

                        <!-- Статус валидации -->
                        <TextBlock Text="✅ Статус дампа" Style="{StaticResource SectionHeader}"/>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="10" Background="#FAFAFA">
                            <StackPanel>
                                <TextBlock x:Name="TxtDumpStatus" Text="Дамп не загружен" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtDumpSize" Text="Размер: -" Margin="0,5,0,0" Foreground="#666"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Правая панель: Hex редактор -->
            <Border Grid.Column="1" Background="White" CornerRadius="5" Padding="15" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📝 Hex Редактор" Style="{StaticResource SectionHeader}"/>
                    
                    <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Background="#1E1E1E">
                        <ScrollViewer x:Name="HexScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="HexEditor" 
                                     FontFamily="Consolas" 
                                     FontSize="13"
                                     Background="#1E1E1E" 
                                     Foreground="#D4D4D4"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Панель управления -->
        <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="15" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Изменение пробега -->
                <GroupBox Grid.Column="0" Header="Изменение пробега" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Новый пробег (км):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtNewMileage" TextAlignment="Right" Padding="8,5"/>
                        <Button Grid.Column="2" Content="Apply" Style="{StaticResource PrimaryButton}" 
                                x:Name="BtnApplyMileage" Click="ApplyMileage_Click" IsEnabled="False"/>
                    </Grid>
                </GroupBox>

                <!-- IMMO OFF -->
                <GroupBox Grid.Column="2" Header="Иммобилайзер" Padding="10" Margin="20,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🔓 IMMO OFF" Style="{StaticResource PrimaryButton}" 
                                x:Name="BtnImmoOff" Click="ImmoOff_Click" IsEnabled="False" Padding="20,10"/>
                        <TextBlock Grid.Column="1" x:Name="TxtImmoWarning" 
                                   Text="⚠ Требуется известная версия крипто-маски" 
                                   Foreground="#FF6B00" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </Border>

        <!-- Логгер / Консоль -->
        <Border Grid.Row="3" Background="#2D2D30" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="📋 Лог операций" Foreground="#CCCCCC" FontWeight="Bold" Margin="0,0,0,5"/>
                
                <TextBox Grid.Row="1" x:Name="LogConsole" 
                         Background="#1E1E1E" 
                         Foreground="#00FF00"
                         FontFamily="Consolas" 
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
