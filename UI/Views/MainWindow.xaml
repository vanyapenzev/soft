<Window x:Class="VagImmoEditor.Pro.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VagImmoEditor.Pro.UI.ViewModels"
        xmlns:converters="clr-namespace:VagImmoEditor.Pro.UI.Converters"
        mc:Ignorable="d"
        Title="VAG IMMO Editor Pro - 24LC64 EEPROM Editor" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CrcStatusToColorConverter x:Key="CrcToColor"/>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="E_xport to JSON" Command="{Binding ExportToJsonCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Compare Files" Command="{Binding CompareFilesCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Button Content="📂 Open" Command="{Binding OpenFileCommand}" ToolTip="Open BIN file"/>
                <Button Content="💾 Save" Command="{Binding SaveFileCommand}" ToolTip="Save BIN file"/>
                <Separator/>
                <Button Content="↩ Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
                <Button Content="↪ Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
                <Separator/>
                <Button Content="📊 Export JSON" Command="{Binding ExportToJsonCommand}"/>
                <Button Content="🔍 Compare" Command="{Binding CompareFilesCommand}"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - IMMO Data -->
            <GroupBox Grid.Column="0" Header="IMMO Data" Margin="0,0,5,0">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="File:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Text="Type:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ImmoType}"/>

                        <TextBlock Grid.Row="2" Text="Manufacturer:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Manufacturer}"/>

                        <TextBlock Grid.Row="3" Text="PIN Code:" FontWeight="Bold" Foreground="Red"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PinCode, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="16" FontWeight="Bold" MaxLength="7"/>

                        <TextBlock Grid.Row="4" Text="Mileage:" FontWeight="Bold"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="14"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text=" km" HorizontalAlignment="Right" Margin="0,0,5,0"/>

                        <TextBlock Grid.Row="5" Text="VIN:" FontWeight="Bold"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}" 
                                 MaxLength="17" CharacterCasing="Upper"/>

                        <TextBlock Grid.Row="6" Text="Key Count:" FontWeight="Bold"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding KeyCount, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="50" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="7" Text="Country Code:" FontWeight="Bold"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="50" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="8" Text="CRC Status:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CrcStatus}" 
                                   FontWeight="Bold" Foreground="{Binding CrcStatus, Converter={StaticResource CrcToColor}}"/>

                        <TextBlock Grid.Row="9" Text="EEPROM Map:" FontWeight="Bold"/>
                        <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding AvailableMaps}" 
                                  SelectedItem="{Binding SelectedMap}" DisplayMemberPath="Name"/>
                    </Grid>

                    <!-- Options -->
                    <GroupBox Header="Options" Margin="0,15,0,0">
                        <StackPanel Margin="5">
                            <CheckBox Content="Component Protection" 
                                      IsChecked="{Binding ComponentProtection}"
                                      ToolTip="{Binding Options[0].Tooltip}"/>
                            <CheckBox Content="Learning Mode" 
                                      IsChecked="{Binding LearningMode}"
                                      ToolTip="{Binding Options[1].Tooltip}"/>
                            <CheckBox Content="Immobilizer Active" 
                                      IsChecked="{Binding ImmobilizerActive}"
                                      ToolTip="{Binding Options[2].Tooltip}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </GroupBox>

            <!-- Right Panel - Hex Editor Preview -->
            <GroupBox Grid.Column="1" Header="EEPROM Hex View (Preview)">
                <Grid Margin="10">
                    <TextBlock Text="Hex editor view would be implemented here.&#10;&#10;Full hex editor with direct byte editing is planned for future versions." 
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" 
                               FontStyle="Italic" Foreground="Gray"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CRC: "/>
                    <TextBlock Text="{Binding StoredCrc, StringFormat='0x{0:X4}'}" FontWeight="Bold"/>
                    <TextBlock Text=" → Calculated: "/>
                    <TextBlock Text="{Binding CalculatedCrc, StringFormat='0x{0:X4}'}" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
