<Window x:Class="VagImmoEditor.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VagImmoEditor.UI.ViewModels"
        mc:Ignorable="d"
        Title="VAG IMMO Editor Pro - 24LC64" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="VAG IMMO Editor Pro" FontSize="28" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Редактор прошивок иммобилайзеров VAG (24LC64)" FontSize="14" Foreground="#666" Margin="0,5,0,0"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📂 Открыть" Command="{Binding LoadFileCommand}" Style="{StaticResource ModernButton}" Margin="0,0,10,0"/>
                <Button Content="💾 Сохранить" Command="{Binding SaveFileCommand}" Style="{StaticResource ModernButton}" Margin="0,0,10,0"/>
                <Button Content="↩ Undo" Command="{Binding UndoCommand}" Style="{StaticResource ModernButton}" Margin="0,0,10,0"/>
                <Button Content="↪ Redo" Command="{Binding RedoCommand}" Style="{StaticResource ModernButton}"/>
            </StackPanel>
        </Grid>

        <!-- Основная информация -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" Effect="{StaticResource {x:Static SystemColors.DropShadowKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- PIN -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,20,15">
                    <TextBlock Text="PIN IMMO" Style="{StaticResource DataLabel}" Foreground="#666"/>
                    <TextBox Text="{Binding PinCode, Mode=OneWay}" FontSize="24" FontWeight="Bold" 
                             Foreground="#007ACC" BorderThickness="0" Background="Transparent" 
                             IsReadOnly="True" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Пробег -->
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,20,15">
                    <TextBlock Text="Одометр" Style="{StaticResource DataLabel}" Foreground="#666"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBox Text="{Binding Mileage, Mode=OneWay}" FontSize="24" FontWeight="Bold" 
                                 Foreground="#007ACC" BorderThickness="0" Background="Transparent" 
                                 IsReadOnly="True" Width="120"/>
                        <TextBlock Text="км" FontSize="18" Foreground="#666" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Тип IMMO и CRC -->
                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Тип / CRC" Style="{StaticResource DataLabel}" Foreground="#666"/>
                    <StackPanel Margin="0,5,0,0">
                        <TextBlock Text="{Binding ImmoType}" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="{Binding CrcStatus}" FontSize="14" 
                                   Foreground="{Binding CrcStatus, Converter={StaticResource CrcColorConverter}, FallbackValue=Green}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- VIN -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="VIN номер" Style="{StaticResource DataLabel}" Foreground="#666"/>
                    <TextBox Text="{Binding Vin, Mode=OneWay}" FontSize="16" FontFamily="Consolas" 
                             Foreground="#333" BorderThickness="0" Background="Transparent" 
                             IsReadOnly="True" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Статус -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2">
                    <TextBlock Text="Статус" Style="{StaticResource DataLabel}" Foreground="#666"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#007ACC" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Опции -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Опции иммобилайзера" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding Options}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,5" Background="#F9F9F9" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Индикатор изменений -->
        <Border Grid.Row="3" Background="#E8E8E8" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="💡 Совет: После изменения данных CRC пересчитывается автоматически при сохранении" 
                          Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Undo:" Foreground="#666" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding UndoCount}" FontWeight="Bold" Margin="0,0,15,0"/>
                    <TextBlock Text="Redo:" Foreground="#666" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding RedoCount}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
