<Window x:Class="VagImmoEditor.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VAG IMMO Editor Pro" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="📂 Открыть" Command="{Binding LoadFileCommand}" Padding="10,5" Margin="0,0,5,0"/>
            <Button Content="💾 Сохранить" Command="{Binding SaveFileCommand}" Padding="10,5" Margin="0,0,5,0"/>
            <Separator Width="10" Background="Transparent"/>
            <Button Content="↩ Undo" Command="{Binding UndoCommand}" Padding="10,5" Margin="0,0,5,0"/>
            <Button Content="↪ Redo" Command="{Binding RedoCommand}" Padding="10,5"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Data -->
            <GroupBox Grid.Column="0" Header="Данные иммобилайзера" Margin="0,0,5,0">
                <StackPanel Margin="10">
                    <TextBlock Text="PIN Code:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PinCode, Mode=OneWay}" FontSize="18" Padding="5" Margin="0,0,0,10" IsReadOnly="True"/>
                    
                    <TextBlock Text="Пробег (км):" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Mileage, Mode=OneWay}" FontSize="18" Padding="5" Margin="0,0,0,10" IsReadOnly="True"/>
                    
                    <TextBlock Text="VIN:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Vin, Mode=OneWay}" FontSize="14" Padding="5" Margin="0,0,0,10" IsReadOnly="True"/>
                    
                    <TextBlock Text="Тип IMMO:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ImmoType}" FontSize="14" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="CRC Статус:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding CrcStatus}" FontSize="14" FontWeight="Bold" Foreground="Red"/>
                </StackPanel>
            </GroupBox>

            <!-- Right Panel - Options -->
            <GroupBox Grid.Column="1" Header="Опции" Margin="5,0,0,0">
                <ListBox ItemsSource="{Binding Options}" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" 
                                      IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{Binding Description}"
                                      Command="{Binding DataContext.ToggleOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"
                                      Margin="0,5"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}"/>
        </StatusBar>
    </Grid>
</Window>
