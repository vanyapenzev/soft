<Window x:Class="VagImmoEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VagImmoEditor.ViewModels"
        mc:Ignorable="d"
        Title="VAG IMMO Editor - Редактор прошивок иммобилайзеров" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DataCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Меню -->
        <Menu Grid.Row="0" Background="#2D2D30">
            <MenuItem Header="_Файл" Foreground="White">
                <MenuItem Header="_Открыть..." Command="{Binding LoadFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Сохранить" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Правка" Foreground="White">
                <MenuItem Header="_Обновить данные" Command="{Binding RefreshDataCommand}" InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="_Справка" Foreground="White">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- Панель инструментов -->
        <ToolBarTray Grid.Row="0" VerticalAlignment="Top" Margin="0,30,0,0" Background="#F5F5F5">
            <ToolBar BandIndex="0">
                <Button Content="📂 Открыть" Command="{Binding LoadFileCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="💾 Сохранить" Command="{Binding SaveFileCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Separator/>
                <Button Content="🔄 Обновить" Command="{Binding RefreshDataCommand}" Style="{StaticResource MenuButtonStyle}"/>
            </ToolBar>
        </ToolBarTray>
        
        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Информация о файле -->
                <GroupBox Grid.Row="0" Header="Информация о файле" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Файл:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="| Статус:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontStyle="Italic"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- Данные иммобилайзера -->
                <GroupBox Grid.Row="1" Header="Данные иммобилайзера" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- PIN IMMO -->
                        <Border Grid.Column="0" Style="{StaticResource DataCardStyle}">
                            <StackPanel>
                                <TextBlock Text="PIN IMMO" Style="{StaticResource HeaderTextStyle}" 
                                           HorizontalAlignment="Center" Foreground="#D32F2F"/>
                                <TextBlock Text="{Binding PinCode, FallbackValue='N/A'}" 
                                           FontSize="36" FontWeight="Bold" 
                                           HorizontalAlignment="Center"
                                           Foreground="#D32F2F"/>
                                <TextBlock Text="Код доступа" HorizontalAlignment="Center" 
                                           FontStyle="Italic" Foreground="#666666"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Пробег -->
                        <Border Grid.Column="1" Style="{StaticResource DataCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ОДОМЕТР" Style="{StaticResource HeaderTextStyle}" 
                                           HorizontalAlignment="Center" Foreground="#1976D2"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Mileage}" FontSize="32" FontWeight="Bold"
                                               Foreground="#1976D2"/>
                                    <TextBlock Text="{Binding MileageUnit}" FontSize="20" 
                                               VerticalAlignment="Bottom" Margin="5,0,0,5"
                                               Foreground="#1976D2"/>
                                </StackPanel>
                                <TextBlock Text="Пробег автомобиля" HorizontalAlignment="Center" 
                                           FontStyle="Italic" Foreground="#666666"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Тип и ключи -->
                        <Border Grid.Column="2" Style="{StaticResource DataCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ТИП СИСТЕМЫ" Style="{StaticResource HeaderTextStyle}" 
                                           HorizontalAlignment="Center" Foreground="#388E3C"/>
                                <TextBlock Text="{Binding ImmoType}" FontSize="24" FontWeight="Bold" 
                                           HorizontalAlignment="Center" Foreground="#388E3C"/>
                                <TextBlock Text="{Binding KeyCount, StringFormat='Ключей: {0}'}" 
                                           FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,0"
                                           Foreground="#388E3C"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Дополнительная информация -->
                        <Grid Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="5">
                                <TextBlock Text="Component ID:" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text="{Binding ComponentId}" Style="{StaticResource ValueTextStyle}"/>
                                
                                <TextBlock Text="VIN:" Style="{StaticResource InfoLabelStyle}" Margin="20,10,5,5"/>
                                <TextBlock Text="{Binding Vin, FallbackValue='N/A'}" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="5">
                                <TextBlock Text="Статус:" Style="{StaticResource InfoLabelStyle}"/>
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>
                
                <!-- Список опций -->
                <GroupBox Grid.Row="2" Header="Опции и настройки" Style="{StaticResource GroupBoxStyle}">
                    <TabControl Margin="5">
                        <TabItem Header="Все опции">
                            <ListView ItemsSource="{Binding OptionsList}" 
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" Margin="2" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Description}" 
                                                               FontSize="12" Foreground="#666666" 
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Category, StringFormat='Категория: {0}'}" 
                                                               FontSize="11" Foreground="#999999" 
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>
                                                
                                                <CheckBox Grid.Column="1" 
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Visibility="{Binding Type, Converter={StaticResource BoolToVis}, ConverterParameter=Boolean}"
                                                          VerticalAlignment="Center"
                                                          Margin="10"
                                                          ToolTip="Вкл/Выкл опцию"/>
                                                
                                                <Button Grid.Column="2" Content="Применить" 
                                                        Command="{Binding DataContext.ApplyOptionCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                                        Padding="15,5"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabItem>
                        
                        <TabItem Header="Безопасность">
                            <TextBlock Text="Настройки безопасности будут отображены здесь" 
                                       Margin="20" Foreground="#666666"/>
                        </TabItem>
                        
                        <TabItem Header="Ключи">
                            <TextBlock Text="Управление ключами будет отображено здесь" 
                                       Margin="20" Foreground="#666666"/>
                        </TabItem>
                    </TabControl>
                </GroupBox>
            </Grid>
        </ScrollViewer>
        
        <!-- Строка состояния -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="VAG IMMO Editor v1.0 | 24LC64 EEPROM"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
